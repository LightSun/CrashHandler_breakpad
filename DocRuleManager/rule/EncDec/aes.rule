            /**/Method{
                name: cfb8
                paramStr: CString,CString,CString,bool
                returnStr: String
                desc: cfb8模式执行AES
            }
            Method{
                name: cfb128
                paramStr: CString,CString,CString,bool
                returnStr: String
                desc: cfb128模式执行AES
                preset: ([加密模式下，加密的key有效并且内容不为空->返回加密后的内容][加密模式下，加密的key无效或者内容为空->返回空字符串]
                        [解密模式下，解密的key有效并且内容不为空->返回解密后的内容][解密模式下，解密的key无效或者内容为空->返回空字符串])
            }
            Method{
                name: ofb128
                paramStr: CString,CString,CString,bool
                returnStr: String
                desc: cfb128模式执行AES
                preset: ([加密模式下，加密的key有效并且内容不为空->返回加密后的内容][加密模式下，加密的key无效或者内容为空->返回空字符串]
                         [解密模式下，解密的key有效并且内容不为空->返回解密后的内容][解密模式下，解密的key无效或者内容为空->返回空字符串])
            }
