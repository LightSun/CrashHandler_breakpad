
DocRule{
    title: 乳腺肿块超声影像辅助诊断软件
    saveFile: test_docx/ibs3.2_EncDec.docx
    Module{
        index: 1
        name: 加密解密模块
        ClassItem{
            desc: AES加解密算法的封装
            funcContent: 主要负责AES各种算法的加密和解密
            ClassDefine{
                className: AES
                superClassName:
            }
            Field{
                name: m_tc
                type: int
                desc: 并行的线程数
            }
            Field{
                name: m_maxLen
                type: size_t
                desc: 数据块最大的长度
            }    
            Method{
                name: getMaxThreadCount
                paramStr: void
                returnStr: int
                desc: 获取最大线程数
                preset: ([->返回值大于0])
            }
            /**/Method{
                name: ecb
                paramStr: CString,CString,bool
                returnStr: String
                desc: ecb模式执行AES
            }
            /**/Method{
                name: cbc
                paramStr: CString,CString,CString,bool
                returnStr: String
